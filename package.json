{
  "name": "luna",
  "version": "0.1.0",
  "description": "Windows 向けデスクトップマスコット",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check:docs": "python3 scripts/check-docs.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:docs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "electron": "^44.2.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
